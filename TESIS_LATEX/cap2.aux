\@writefile{lof}{\contentsline {figure}{\numberline {2.2}{\ignorespaces Procesamiento paso a paso de las señales y diagramas de constelación del transceptor en un canal óptico de línea de vista (LOS) ideal a una distancia de 3.0 m, en ausencia de ruido solar de fondo ($E_{\text  {sol}} = 0\text  { W/m}^2$) y con un ruido térmico mínimo ($\sigma ^2_{\text  {thermal}} = 10^{-15}\text  { A}^2$). Se observa la constelación 16-QAM recibida perfectamente ecualizada, logrando una tasa de error de bit de BER = 0.0.}}{30}{figure.caption.11}\protected@file@percent }
\newlabel{fig:resultado_ideal}{{2.2}{30}{Procesamiento paso a paso de las señales y diagramas de constelación del transceptor en un canal óptico de línea de vista (LOS) ideal a una distancia de 3.0 m, en ausencia de ruido solar de fondo ($E_{\text {sol}} = 0\text { W/m}^2$) y con un ruido térmico mínimo ($\sigma ^2_{\text {thermal}} = 10^{-15}\text { A}^2$). Se observa la constelación 16-QAM recibida perfectamente ecualizada, logrando una tasa de error de bit de BER = 0.0}{figure.caption.11}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2.3}{\ignorespaces Procesamiento paso a paso de las señales y diagramas de constelación del transceptor operando bajo ruido solar de fondo severo continuo a mediodía ($E_{\text  {sol}} = 150\text  { W/m}^2$) a una distancia de 3.0 m. La alta corriente de fondo genera un intenso ruido de disparo que distorsiona la constelación 16-QAM ecualizada en el receptor, produciendo una tasa de error de bit no nula.}}{31}{figure.caption.12}\protected@file@percent }
\newlabel{fig:resultado_real}{{2.3}{31}{Procesamiento paso a paso de las señales y diagramas de constelación del transceptor operando bajo ruido solar de fondo severo continuo a mediodía ($E_{\text {sol}} = 150\text { W/m}^2$) a una distancia de 3.0 m. La alta corriente de fondo genera un intenso ruido de disparo que distorsiona la constelación 16-QAM ecualizada en el receptor, produciendo una tasa de error de bit no nula}{figure.caption.12}{}}
